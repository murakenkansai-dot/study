<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>友人限定サイト</title>
  <style>
    body {
      font-family: sans-serif;
      background-color: #f4f4f9;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
    }
    .box {
      background: white;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
      text-align: center;
      max-width: 400px;
      width: 90%;
    }
    input {
      padding: 10px;
      font-size: 16px;
      border: 1px solid #ccc;
      border-radius: 6px;
      width: 80%;
      margin-bottom: 15px;
    }
    button {
      padding: 10px 20px;
      font-size: 16px;
      background-color: #007bff;
      color: white;
      border: none;
      border-radius: 6px;
      cursor: pointer;
    }
    button:hover {
      background-color: #0056b3;
    }
    #secret-content {
      display: none;
    }
  </style>
</head>
<body>

  <!-- パスワード入力画面 -->
  <div id="login-box" class="box">
    <h2>鍵付きページ</h2>
    <p>パスワードを入力してください</p>
    <input type="password" id="password-input" placeholder="パスワード">
    <br>
    <button onclick="checkPassword()">入室する</button>
    <p id="error-message" style="color: red; display: none;">合言葉が違います</p>
  </div>

  <!-- ログイン後に表示されるメインコンテンツ -->
  <div id="secret-content" class="box">
    <h1>ようこそ！</h1>
    <p>ここが友達限定の秘密ページです。</p>
    <p>ここに好きなメッセージやコンテンツを載せていきましょう！</p>
  </div>

  <script>
    function checkPassword() {
      // ↓ 「1234」の場所を好きな合言葉（パスワード）に変更してください
      const secretPassword = "1234"; 

      const input = document.getElementById("password-input").value;
      if (input === secretPassword) {
        document.getElementById("login-box").style.display = "none";
        document.getElementById("secret-content").style.display = "block";
      } else {
        document.getElementById("error-message").style.display = "block";
      }
    }
  </script>

</body>
</html>
